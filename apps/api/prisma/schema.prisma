generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum StaffRole {
  CLEANER
  MAINTENANCE
  BOTH
}

enum TaskType {
  CLEANING
  MAINTENANCE
  INSPECTION
  OTHER
}

enum TriggerType {
  ARRIVAL
  DEPARTURE
  RECURRING
  ONE_OFF
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  name      String
  role      Role
  clerkId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffMember {
  id        String    @id @default(cuid())
  name      String    @unique
  email     String    @unique
  role      StaffRole @default(CLEANER)
  clerkId   String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  assignedTasks    Task[]
  defaultTemplates TaskTemplate[]
}

model Property {
  id            String   @id @default(cuid())
  name          String
  address       String
  coverImageUrl String?
  wifiPassword  String?
  doorPin       String?
  ownerRezId    String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reservations      Reservation[]
  tasks             Task[]
  templateLinks     TaskTemplateProperty[]
  recurrenceLogs    TaskRecurrenceLog[]
}

model Reservation {
  id             String   @id @default(cuid())
  propertyId     String
  guestArrival   DateTime
  guestDeparture DateTime
  ownerRezId     String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  tasks    Task[]
}

model TaskTemplate {
  id                     String      @id @default(cuid())
  name                   String
  description            String?
  taskType               TaskType    @default(CLEANING)
  triggerType            TriggerType @default(ONE_OFF)
  recurrenceIntervalDays Int?
  defaultAssigneeId      String?
  checklistItems         Json?
  isActive               Boolean     @default(true)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  defaultAssignee  StaffMember?           @relation(fields: [defaultAssigneeId], references: [id])
  properties       TaskTemplateProperty[]
  tasks            Task[]
  recurrenceLogs   TaskRecurrenceLog[]
}

model TaskTemplateProperty {
  id         String @id @default(cuid())
  templateId String
  propertyId String

  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  property Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([templateId, propertyId])
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  taskType       TaskType   @default(CLEANING)
  status         TaskStatus @default(PENDING)
  propertyId     String
  templateId     String?
  bookingId      String?
  assignedTo     String?
  dueDate        DateTime
  completedAt    DateTime?
  checklistItems Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  property  Property      @relation(fields: [propertyId], references: [id])
  template  TaskTemplate? @relation(fields: [templateId], references: [id])
  booking   Reservation?  @relation(fields: [bookingId], references: [id])
  assignee  StaffMember?  @relation(fields: [assignedTo], references: [id])
}

model TaskRecurrenceLog {
  id              String   @id @default(cuid())
  templateId      String
  propertyId      String
  lastGeneratedAt DateTime @default(now())
  nextDueDate     DateTime

  template TaskTemplate @relation(fields: [templateId], references: [id])
  property Property     @relation(fields: [propertyId], references: [id])
}

model SyncLog {
  id         String   @id @default(cuid())
  entity     String
  ownerRezId String
  syncedAt   DateTime @default(now())
  status     String
}